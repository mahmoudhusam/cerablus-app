# Cerablus Coffee — environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env / .env.local.

# ---------------------------------------------------------------------------
# NEEDED NOW — Neon Postgres (Step 1)
# ---------------------------------------------------------------------------

# Pooled Neon connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct/unpooled Neon connection (same host WITHOUT "-pooler"). Used only by
# `prisma migrate` — schema changes need a real session, not a pooled one.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# NEEDED NOW — public site (Step 3)
# ---------------------------------------------------------------------------

# The cafe's WhatsApp number, international format, digits only (no +, no
# spaces). Read on the server and passed into the client tree as a prop; it is
# deliberately NOT a NEXT_PUBLIC_* variable. Leave it empty and every wa.me link
# falls back to the placeholder 970590000000.
CERABLUS_WHATSAPP_PHONE=""

# The site's own origin, used to make canonical + Open Graph URLs absolute.
# Unset falls back to the reserved placeholder https://cerablus.example.
# Set for real at Step 7, when the custom domain is attached.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# NEEDED NOW — admin login (Step 4)
# ---------------------------------------------------------------------------
# ONE owner. There is no user table, no sign-up and no password reset: these
# four variables ARE the account. Rotating the password means regenerating the
# hash and redeploying.

# Signs and verifies the session cookie. Generate a fresh one per environment:
#   openssl rand -base64 32
# Changing it invalidates every existing session, which is how you force a
# logout everywhere.
NEXTAUTH_SECRET=""

# The full origin this deployment serves from — no trailing slash. Also decides
# whether the session cookie is marked Secure (https -> yes).
NEXTAUTH_URL="http://localhost:3000"

# The owner's login name. Compared in constant time; not a secret on its own,
# but do not publish it either.
ADMIN_USERNAME=""

# A bcrypt HASH of the owner's password — never the password itself. Generate
# it on your own machine and paste the result here:
#   npm run hash-password
# Keep the surrounding quotes: the hash contains $ characters.
ADMIN_PASSWORD_HASH=""

# ---------------------------------------------------------------------------
# NEEDED LATER — not read by any code yet
# ---------------------------------------------------------------------------

# Step 6 (item photo uploads): from the Cloudinary dashboard. Server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
