# Cerablus Coffee — environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env / .env.local.

# ---------------------------------------------------------------------------
# NEEDED NOW (Step 1) — Neon Postgres
# ---------------------------------------------------------------------------

# Pooled Neon connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct/unpooled Neon connection (same host WITHOUT "-pooler"). Used only by
# `prisma migrate` — schema changes need a real session, not a pooled one.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# NEEDED LATER — not read by any code yet
# ---------------------------------------------------------------------------

# Step 4 (admin auth): random 32+ byte secret, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET=""
# Step 4: full origin of the deployment, e.g. https://cerablus.com
NEXTAUTH_URL="http://localhost:3000"
# Step 4: the single owner login. Store a HASH, never a plaintext password.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Step 6 (item photo uploads): from the Cloudinary dashboard. Server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Step 3 (WhatsApp order): café number in international format, digits only.
CERABLUS_WHATSAPP_PHONE=""
